{
  // Type-checks the UI and the compression engine (browser code).
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/ui/**/*.ts", "src/engine/**/*.ts", "src/shared/**/*.ts"]
}
